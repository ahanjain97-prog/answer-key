EPS = 1e-9


def _to_float_or_nan_close(x):
    if x is None:
        return np.nan
    s = str(x).strip()
    if s == "" or s.lower() == "nl":
        return np.nan
    try:
        return float(s)
    except (ValueError, TypeError):
        return np.nan


def _to_float_score(x):
    try:
        return float(str(x).strip())
    except (ValueError, TypeError):
        return np.nan


def _american_to_decimal(odds: Optional[float]) -> Optional[float]:
    if odds is None or not isfinite(odds) or odds == 0:
        return None
    return 1.0 + (odds / 100.0 if odds > 0 else 100.0 / abs(odds))


def _no_vig_prob_from_two_american(a_side: Optional[float], b_side: Optional[float]) -> Optional[float]:
    da = _american_to_decimal(a_side)
    db = _american_to_decimal(b_side)
    if da is None or db is None:
        return None
    imp_a = 1.0 / da
    imp_b = 1.0 / db
    s = imp_a + imp_b
    if s <= 0:
        return None
    return imp_a / s


def _prob_to_american(p: float) -> Optional[int]:
    if not isfinite(p) or p <= 0.0 or p >= 1.0:
        return None
    if p >= 0.5:
        return int(round(-100 * p / (1.0 - p)))
    else:
        return int(round(100 * (1.0 - p) / p))


def _ev_from_probs_and_odds(p_win: float, p_loss: float, p_push: float, american_odds: float) -> Optional[float]:
    """
    EV per 1u stake with push=void:
      EV = p_win*(decimal-1) - p_loss*1
      (p_push neither wins nor loses)
    """
    dec = _american_to_decimal(american_odds)
    if dec is None:
        return None
    return p_win * (dec - 1.0) - p_loss * 1.0


def _grade_spread_home_perspective(margin: float, home_spread: float) -> str:
    diff = margin + home_spread
    if abs(diff) <= EPS:
        return 'push'
    return 'win' if diff > 0 else 'loss'


def _grade_total_value(actual_value: float, line: float) -> str:
    diff = actual_value - line
    if abs(diff) <= EPS:
        return 'push'
    return 'over' if diff > 0 else 'under'


def _parlay_grade(leg1: str, leg2: str) -> str:
    if leg1 == 'loss' or leg2 == 'loss':
        return 'loss'
    if leg1 == 'push' or leg2 == 'push':
        return 'push'
    return 'win'


def safe_sum_or_nan(*vals) -> float:
    for v in vals:
        if not isfinite(v):
            return np.nan
    return float(sum(vals))


# ========================= Uniqueness helpers =========================
def _teams_and_score_key(g: Dict) -> tuple:
    """Stricter uniqueness by teams and final score, ignoring ID."""
    vt = str(g.get('visitor_team', '')).strip().lower()
    ht = str(g.get('home_team', '')).strip().lower()
    vs = g.get('visitor_score')
    hs = g.get('home_score')
    vs_key = int(round(vs)) if pd.notna(vs) and isfinite(vs) else -9999
    hs_key = int(round(hs)) if pd.notna(hs) and isfinite(hs) else -9999
    return (vt, ht, vs_key, hs_key)
