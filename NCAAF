        book_spread_full: Optional[float] = None,
        book_total_full: Optional[float] = None,
        book_spread_1h: Optional[float] = None,
        book_total_1h: Optional[float] = None,
        book_spread_1q: Optional[float] = None,
        book_total_1q: Optional[float] = None,
        team_totals_full: Optional[Tuple[float, float]] = None,
        team_totals_1h: Optional[Tuple[float, float]] = None,
        ev_1h_spread_odds_home: Optional[float] = None,
        ev_1h_spread_odds_away: Optional[float] = None,
        ev_1h_total_odds_over: Optional[float] = None,
        ev_1h_total_odds_under: Optional[float] = None,
        ev_1q_spread_odds_home: Optional[float] = None,
        ev_1q_spread_odds_away: Optional[float] = None,
        ev_1q_total_odds_over: Optional[float] = None,
        ev_1q_total_odds_under: Optional[float] = None,
        ev_1h_ml_home_odds: Optional[float] = None,
        ev_1h_ml_away_odds: Optional[float] = None,
        ev_1q_ml_home_odds: Optional[float] = None,
        ev_1q_ml_away_odds: Optional[float] = None,
    ):
        print("\n" + "="*76)
        print("🚀 Starting Answer Key Analysis 🚀".center(76))
        print(f"Target Line (for indexing): Spread={target_spread:+.1f}, Total={target_total:.1f}".center(76))
        print("="*76)

        self.target_spread, self.target_total = target_spread, target_total

        # Step 2: align means by adjusting indexing target; pushes allowed in sample
        N = sample_size if sample_size % 2 == 0 else sample_size - 1
        adj_s, adj_t, included, excluded = self._align_means(N, target_spread, target_total)

        # Save initial sample snapshot for provenance + push snapshot
        pd.DataFrame(included).to_csv("initial_sample_topN.csv", index=False)
        self._print_initial_push_snapshot(included)

        # Step 3: EXACT median-result balancing on decisive-only counts (push-aware)
        included, excluded = self._balance_medians_exact(included, excluded)

        # Final sample
        final_sample = included
        pd.DataFrame(final_sample).to_csv("final_sample.csv", index=False)
        print("\n✓ Final sample (pushes allowed) saved to 'final_sample.csv'")

        # Derivatives
        derivatives = self._calculate_derivatives(final_sample)
        self._print_results(final_sample, derivatives)

        # Correlated parlays via BOOK lines
        if book_spread_full is None: book_spread_full = target_spread
        if book_total_full  is None: book_total_full  = target_total
        if book_spread_1h   is None: book_spread_1h   = book_spread_full / 2.0
        if book_total_1h    is None: book_total_1h    = book_total_full  / 2.0

        full_counts, h1_counts = self._count_correlated_parlays(
            final_sample,
            book_spread_full, book_total_full,
            book_spread_1h,   book_total_1h
        )

        # Print correlated results
        self._print_correlated("Full Game", full_counts)
        self._print_correlated("1H", h1_counts)

        # Team totals (optional)
        if team_totals_full is None:
            home_tt = (book_total_full - book_spread_full) / 2.0
            away_tt = book_total_full - home_tt
        else:
            home_tt, away_tt = team_totals_full

        if team_totals_1h is None:
            home_tt_1h = (book_total_1h - book_spread_1h) / 2.0
            away_tt_1h = book_total_1h - home_tt_1h
        else:
            home_tt_1h, away_tt_1h = team_totals_1h

        tt_counts = self._count_team_totals(final_sample, home_tt, away_tt, home_tt_1h, away_tt_1h, book_total_1h)

        def pct(x, n): return (x / n * 100.0) if n else 0.0
        Ntt = tt_counts['N']

        print("\n--- Team Totals (Full Game) by counting (win/loss/push rates) ---")
        print(f"home_tt_line         {tt_counts['full']['home_tt_line']:.2f}")
        print(f"away_tt_line         {tt_counts['full']['away_tt_line']:.2f}")
        print(f"home_over            {pct(tt_counts['full']['home_over'], Ntt):.2f}%")
        print(f"home_under           {pct(tt_counts['full']['home_under'], Ntt):.2f}%")
        print(f"home_push            {pct(tt_counts['full']['home_push'], Ntt):.2f}%")
        print(f"away_over            {pct(tt_counts['full']['away_over'], Ntt):.2f}%")
        print(f"away_under           {pct(tt_counts['full']['away_under'], Ntt):.2f}%")
        print(f"away_push            {pct(tt_counts['full']['away_push'], Ntt):.2f}%")

        print("\n--- Team Totals (1H) by counting (win/loss/push rates) ---")
        print(f"home_tt_line         {tt_counts['h1']['home_tt_line']:.2f}")
        print(f"away_tt_line         {tt_counts['h1']['away_tt_line']:.2f}")
        print(f"total_line(1H)       {tt_counts['h1']['total_line']:.2f}")
        print(f"home_over            {pct(tt_counts['h1']['home_over'], Ntt):.2f}%")
        print(f"home_under           {pct(tt_counts['h1']['home_under'], Ntt):.2f}%")
        print(f"home_push            {pct(tt_counts['h1']['home_push'], Ntt):.2f}%")
        print(f"away_over            {pct(tt_counts['h1']['away_over'], Ntt):.2f}%")
        print(f"away_under           {pct(tt_counts['h1']['away_under'], Ntt):.2f}%")
        print(f"away_push            {pct(tt_counts['h1']['away_push'], Ntt):.2f}%")

        # ===== EV (1H & 1Q) =====
        h1_margins = [g['h1_margin'] for g in final_sample if isfinite(g['h1_margin'])]
        h1_totals  = [g['h1_total']  for g in final_sample if isfinite(g['h1_total'])]
        q1_margins = [g['q1_margin'] for g in final_sample if isfinite(g['q1_margin'])]
        q1_totals  = [g['q1_total']  for g in final_sample if isfinite(g['q1_total'])]

        if book_spread_1q is None: book_spread_1q = (book_spread_full / 4.0)
        if book_total_1q  is None: book_total_1q  = (book_total_full  / 4.0)

        self._print_ev_report_spread_total(
            "1H",
            spread_line=book_spread_1h,
            spread_odds_home=ev_1h_spread_odds_home,
            spread_odds_away=ev_1h_spread_odds_away,
            total_line=book_total_1h,
            total_odds_over=ev_1h_total_odds_over,
            total_odds_under=ev_1h_total_odds_under,
            margins=h1_margins,
            totals=h1_totals
        )
        self._print_ev_report_moneyline(
            "1H",
            ml_home_odds=ev_1h_ml_home_odds,
            ml_away_odds=ev_1h_ml_home_odds if ev_1h_ml_away_odds is None else ev_1h_ml_away_odds,
            margins=h1_margins
        )

        self._print_ev_report_spread_total(
            "1Q",
            spread_line=book_spread_1q,
            spread_odds_home=ev_1q_spread_odds_home,
            spread_odds_away=ev_1q_spread_odds_away,
            total_line=book_total_1q,
            total_odds_over=ev_1q_total_odds_over,
            total_odds_under=ev_1q_total_odds_under,
            margins=q1_margins,
            totals=q1_totals
        )
        self._print_ev_report_moneyline(
            "1Q",
            ml_home_odds=ev_1q_ml_home_odds,
            ml_away_odds=ev_1q_ml_home_odds if ev_1q_ml_away_odds is None else ev_1q_ml_away_odds,
            margins=q1_margins
        )

        pd.DataFrame([{
            'book_spread_full': book_spread_full,
            'book_total_full':  book_total_full,
            'book_spread_1h':   book_spread_1h,
            'book_total_1h':    book_total_1h,
            'book_spread_1q':   book_spread_1q,
            'book_total_1q':    book_total_1q
        }]).to_csv("book_lines_used.csv", index=False)


def main():
    # Resolve parent target spread sign from CONFIG
    t_spread = float(CONFIG["TARGET"]["spread"])
    t_total  = float(CONFIG["TARGET"]["total"])
    fav_side = str(CONFIG["TARGET"]["favorite"]).strip().lower()
    if fav_side not in ("home", "away"):
        raise ValueError("CONFIG.TARGET.favorite must be 'home' or 'away'")
    target_spread = -abs(t_spread) if fav_side == "home" else abs(t_spread)

    # Resolve BOOK lines
    B = CONFIG["BOOK"]
    full_spread = B["full"]["spread"] if B["full"]["spread"] is not None else target_spread
    full_total  = B["full"]["total"]  if B["full"]["total"]  is not None else t_total

    h1_spread = B["1H"]["spread"] if B["1H"]["spread"] is not None else (full_spread / 2.0)
    h1_total  = B["1H"]["total"]  if B["1H"]["total"]  is not None else (full_total  / 2.0)

    q1_spread = B["1Q"]["spread"] if B["1Q"]["spread"] is not None else (full_spread / 4.0)
    q1_total  = B["1Q"]["total"]  if B["1Q"]["total"]  is not None else (full_total  / 4.0)

    # Team totals (defaults if None) using BOOK lines
    TT = CONFIG["TEAM_TOTALS"]
    if TT["full"]["home"] is None or TT["full"]["away"] is None:
        home_tt = (full_total - full_spread) / 2.0
        away_tt = full_total - home_tt
    else:
        home_tt = float(TT["full"]["home"])
        away_tt = float(TT["full"]["away"])

    if TT["1H"]["home"] is None or TT["1H"]["away"] is None:
        home_tt_1h = (h1_total - h1_spread) / 2.0
        away_tt_1h = h1_total - home_tt_1h
    else:
        home_tt_1h = float(TT["1H"]["home"])
        away_tt_1h = float(TT["1H"]["away"])

    # EV odds (side-specific)
    EV = CONFIG["EV"]
    ev_1h_spread_odds_home = EV["1H"]["spread_odds"]["home"]
    ev_1h_spread_odds_away = EV["1H"]["spread_odds"]["away"]
    ev_1h_total_odds_over  = EV["1H"]["total_odds"]["over"]
    ev_1h_total_odds_under = EV["1H"]["total_odds"]["under"]
    ev_1q_spread_odds_home = EV["1Q"]["spread_odds"]["home"]
    ev_1q_spread_odds_away = EV["1Q"]["spread_odds"]["away"]
    ev_1q_total_odds_over  = EV["1Q"]["total_odds"]["over"]
    ev_1q_total_odds_under = EV["1Q"]["total_odds"]["under"]
    ev_1h_ml_home_odds     = EV["1H"]["ml_home_odds"]
    ev_1h_ml_away_odds     = EV["1H"]["ml_away_odds"]
    ev_1q_ml_home_odds     = EV["1Q"]["ml_home_odds"]
    ev_1q_ml_away_odds     = EV["1Q"]["ml_away_odds"]

    # Enforce even N
    N = int(CONFIG["SAMPLE_SIZE"])
    if N % 2 == 1:
        N -= 1

    algo = AnswerKeyAlgorithm(CONFIG["DATA_PATH"])
    algo.run_analysis(
        target_spread=target_spread,
        target_total=t_total,
        sample_size=N,
        book_spread_full=full_spread,
        book_total_full=full_total,
        book_spread_1h=h1_spread,
        book_total_1h=h1_total,
        book_spread_1q=q1_spread,
        book_total_1q=q1_total,
        team_totals_full=(home_tt, away_tt),
        team_totals_1h=(home_tt_1h, away_tt_1h),
        ev_1h_spread_odds_home=ev_1h_spread_odds_home,
        ev_1h_spread_odds_away=ev_1h_spread_odds_away,
        ev_1h_total_odds_over=ev_1h_total_odds_over,
        ev_1h_total_odds_under=ev_1h_total_odds_under,
        ev_1q_spread_odds_home=ev_1q_spread_odds_home,
        ev_1q_spread_odds_away=ev_1q_spread_odds_away,
        ev_1q_total_odds_over=ev_1q_total_odds_over,
        ev_1q_total_odds_under=ev_1q_total_odds_under,
        ev_1h_ml_home_odds=ev_1h_ml_home_odds,
        ev_1h_ml_away_odds=ev_1h_ml_away_odds,
        ev_1q_ml_home_odds=ev_1q_ml_home_odds,
        ev_1q_ml_away_odds=ev_1q_ml_away_odds,
    )


if __name__ == "__main__":
    main()
